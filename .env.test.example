# Copy to .env.test and fill with a DISPOSABLE Supabase project.
# smoke.js refuses to run if TEST_DATABASE_URL matches the live DATABASE_URL.
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=<test-service-role-key>
TEST_SUPABASE_ANON_KEY=<test-anon-key>

# Dedicated smoke users (seeded by npm run seed:smoke-users).
SMOKE_ADMIN_PASSWORD=<random-12-plus-chars>
SMOKE_WAITER_PASSWORD=<random-12-plus-chars>
SMOKE_CASHIER_PASSWORD=<random-12-plus-chars>
